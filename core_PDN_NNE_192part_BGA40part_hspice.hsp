	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_pa_fd_24cc_cnn_2x4_nkc32_clip_max_test_1_A0_PerTile.scp	*** 251202, Ashwin Hand created Max power test, 60us  
 

	
	
