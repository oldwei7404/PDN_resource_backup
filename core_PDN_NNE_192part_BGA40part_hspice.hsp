* Top level spice file 

.option post=1
*.chkanode type=gate dv=0.5*pvdd report=active
.option parhier = local 
.option measform = 1
.option lis_new
.option post probe
.param pi = 3.141592653

*** 200G RAM needed ***

*************************************** Input params **************************
.param Vdd 	= 0.775

.param is_use_ecap_ebed = 1		*** value: 0 or 1, note: this could be baked in pkg model 
.param ecap_choice = 0  *** 0:baseline; 1: Samsung SCRLLC106MG6EGNNWT 10.56uF; 2: Samsung SCRLLC885MG6EGNNWT 8.87uF ; -1: mockup connection to bump grp
*** ecap config info, slide 8 of https://docs.google.com/presentation/d/1orH5VIG1UrYzCUIHZ60a6fJnd-Fa2yBdIXBZB8ctO6Q/edit?slide=id.g399c8a40ad7_4_0#slide=id.g399c8a40ad7_4_0

.param is_use_MIM 		= 0		*** No MIM die model as of 11/26/2025 
.param is_MIM_exp_24x8 	= 0		*** experiment for 24x8 MIM 
.param is_bump_DTC      = 0     *** experiment bump level DTC 

.param induct_eqvlnt_r =  0.m   *** DCR of inductor of ALL phases, use 0.0m if PMIC_opt ==3, use 0.07m if run ideal voltage src
.param PMIC_opt = 1				*** 1: ideal voltage src; 2:ideal voltage src w/ VCVS feedback; 3: voltage src using pwl 
*** NOTE: ONLY applicable if PMIC_opt == 3
* .param volt_src = str('./hspice_inc/MAX20420_40_Top_schem_DL_6phase_ENC8_LL_241209_25MHz_simplify_250307_V_PMIC_out.csv')	*** derived from B0 current "NNE_0p25_PA_resnet_noReLU_250304", no stagger 
* .param volt_src = str('./hspice_inc/MAX20420_40_Top_schem_DL_6phase_ENC8_LL_241209_25MHz_simplify_250309_V_PMIC_out.csv')	*** derived from B0 current "NNE_0p25_PA_resnet_noReLU_250304", 50ns stagger, use current profile accordingly !! 
* .param volt_src = str('./hspice_inc/VpmicOUT_NNE_0p25_PA_IGI_power_test_rivbev_bb_res2_250408.txt_simplis.BW25MHz.csv')
* .param volt_src = str('./hspice_inc/MAX20420_40_Top_schem_DL_6phase_ENC8_LL_241209_25MHz_simplify_sival_32nH_250409_Vpmic_out_modif.csv')  ***  nne valiadation test2, PMIC load line mode, only one PA+IGI parition running, others idling

* .param volt_src = str('./hspice_inc/nne_test_2_4xPart_Vpmic_OUT_BW_25MHz.csv') 	*** nne validation test2, all 4 paritions running, loadline mode  
.param volt_src = str('./hspice_inc/ADI_MAX20420_40_Top_schem_DL_6phase_ENC5_Integrator240916_25MHz_simplify_testcase3_rivbev_bb_res2_test2.csv') 	*** nne validation test2, all 4 paritions running, ADI integrator mode  

* .param volt_src = str('./hspice_inc/MPQ2946_MPQ86761_For_Rivian_Encrypted_VpmicOUT.csv') 	*** nne validation test2, all 4 paritions running, DC loadline mode, MPS 250711   
* .param volt_src = str('./hspice_inc/MPQ2946_MPQ86761_For_Rivian_Enc_ACloadline.csv') 	*** nne validation test2, all 4 paritions running, AC loadline mode, MPS 250716

.param volt_src = str('./hspice_inc/EP9501_EP7503_Rivian_TB_26062401.sxgpx_V_VR_StartFr_0_v2.csv') 	*** 260701 EMpwr IVR teset, 83us, corresponding to "core_PDN_NNE_192part_BGA40part_hspice.tr26043001 "  


.param Vdd_shift_fr_pwl = -0.01

.param is_ac_run = 1		*** 1 if impedance, 0 if transient 

* .param is_row_0_active = 1	***
* .param is_row_1_active = 0	***
* .param is_row_2_active = 0	***
* .param is_row_3_active = 0	***

.param td_delay_stag = 0.n		
.param td_delay_grp0 =  '0.* td_delay_stag'    
.param td_delay_grp1 =  '1.* td_delay_stag'     
.param td_delay_grp2 =  '2.* td_delay_stag'    
.param td_delay_grp3 =  '3.* td_delay_stag'    	

* .param td_delay_perCol_stag = 0.n
* .param td_delay_perCol_grp0 =  '0.* td_delay_perCol_stag'    
* .param td_delay_perCol_grp1 =  '1.* td_delay_perCol_stag'     
* .param td_delay_perCol_grp2 =  '2.* td_delay_perCol_stag'    
* .param td_delay_perCol_grp3 =  '3.* td_delay_perCol_stag'   



	* *** not used when CPM is enabled 
	* .param Cdie_coeff = 1.0				*** ONLY multi grp controlling, use 1.0 if no Cdie scaling, use 3.62 for NNE if MIM cap is added,  
	* .param Rdie_coeff = 1.0				*** Rdie is constant 1. , rather than scaled by '1./Cdie_coeff'

	* *** Cdie Rdie based on MAM-242, tau = 24.26 (excluding MIM)
	* .param Cdie_PA 	= '130.3n * Cdie_coeff'		
	* .param Cdie_MA 	= '101.7n * Cdie_coeff'
	* .param Rdie_PA 	= '0.186m * Rdie_coeff'
	* .param Rdie_MA 	= '0.239m * Rdie_coeff'
	* .param Rleak 	= 0.84
	
*************************************** User defined functions ****************
.param V_meas(node, ref) = 'v(node) - v(ref)'


*************************************** Input Models**************************
***** define load current source model used in die model *****
*** !!! Check before change any current profile   !!!!  
*** additional background DC current (mainly to help decompose profile and smoother staggering, this will require original profile to remove DC values) 
* .param is_use_backgnd_cur = 0
* .param curr_backgnd_PA_1_col = 0.915  		* old: 1.625
* .param curr_backgnd_MA_1_col = 0.535 		* old: 0.95

.param curr_backgnd_PA_1_tile = 0.1525  		
.param curr_backgnd_MA_1_tile = 0.089167	

.param tStep	= 10.p
.param tStop	= 105.u     ** 83.u  	

.param is_curr_defined_external = 1 		*** 1: if current sources files defined externally; 
											*** 0: if define current sources within in this file 
											
.if (is_curr_defined_external == 1 )
	*** ONLY 1 of these can be active, all others need to be commented
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_251120_Ashwin_idle_perTile.scp				*** all Ashwin per tile idle power, 35us 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_260107_idle_perTile.scp				*** all idle power, TT corner, 85 deg, 260107 (much closer power to measurement)
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_251215_Ashwin_idle_perTile.scp				*** all idle power, TT corner, 85 deg
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_idle_2Gclk_PerTile.scp						*** 251203, 4x idle, 35us    
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_260126_B0_idle_perTile.scp					*** 260126, 4x partition idle, B0 database
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_260126_A0_idle_125C_perTile.scp				*** 260202, all idle, A0, 125C 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_260126_B0_idle_125C_perTile.scp				*** 260202, all idle, B0, 125C 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_OthersIdle_PerTile.scp		*** Active share same csv, idle Ashwin per tile , 35us 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_ZeroDataZeroWt_PerTile_OthersIdle_PerTile.scp	*** 251204 1 partition active w/ diff variations, 3x idle, 35us 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_ZeroDataSameWt_PerTile_OthersIdle_PerTile.scp
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_SameDataZeroWt_PerTile_OthersIdle_PerTile.scp
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_PerTile_OthersIdle_PerTile.scp	 *** Active and Idle are all Ashwin per tile , 35us 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_PerTilePwrX2_OthersIdle_PerTile.scp		*** Active pwr x 2,  and Idle are all Ashwin per tile , 35us 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active251215_PerTile_OthersIdle_PerTile.scp	*** 251215, Ashwin ramp_up_0_ramp_down_0, 45us 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_PerTile_OthersIdle_PerTile_260108.scp	*** 260108, fixed mapping for active partition, 45us, idle same as  'curr_profile_NNE_24x8part_260107_idle_perTile' 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5ActivePwrVirus_PerTile_OthersIdle_PerTile_260213.scp	*** 260213, 7us, active parition runs POWER VIRUS, others idle 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row18_23Active_PerTile_OthersIdle_PerTile_260108.scp    *** 260316, innermost partition active, others idle 
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_PerTile_OthersIdle_PerTile_B0_260326.scp	*** (path outdated) 260326, B0 Attention waveform, beachfront active, other partitions idle (B0 version), 105us
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_5Active_PerTile_OthersIdle_PerTile_B0_260903.scp	*** 260903, B0 Attention waveform, beachfront active, other partitions idle (B0 version), 105us
	.inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row18_23Active_PerTile_OthersIdle_PerTile_B0_260903.scp  *** 260903, B0 Attention waveform, innermost active, other partitions idle (B0 version), 105us
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_23Active_PerTile_B0_260903.scp						*** 260903, all partitions active 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_Row0_11Active_PerTile_OthersIdle_PerTile_260108.scp		 *** 260322, Row0-5, 6-11, i.e., 2 partitions active w/ 260108 current, other two idel 
	
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_AllRowActive_PerTile_same_curr.scp			*** All using previous same tile profile, 189us  
	* .inc /data/home/jiangongwei/work/PDN_core/hspice_inc/curr_profile_NNE_24x8part_AllColActive_PerTile.scp						*** all 4 part. using same per tile active profile, 35us 
